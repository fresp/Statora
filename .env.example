# WARNING: change every change-me-* secret before any production deployment.
# APP_ENV=development keeps local placeholders usable; any non-development value fails fast on change-me-* secrets.

# =========================
# Database
# =========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=statusplatform

# =========================
# Redis
# =========================
REDIS_URI=localhost:6379

# =========================
# Security
# =========================
JWT_SECRET=change-me-jwt-secret
APP_ENCRYPTION_KEY=change-me-app-encryption-key!!!!
MFA_SECRET_KEY=change-me-mfa-secret-key!!!!!!!

# =========================
# Server
# =========================
APP_ENV=development
PORT=8080
GRACEFUL_SHUTDOWN=true
SHUTDOWN_TIMEOUT=10

# =========================
# Default Admin (bootstrap only)
# =========================
ADMIN_EMAIL=admin@statusplatform.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# =========================
# Worker
# =========================
ENABLE_WORKER=true
